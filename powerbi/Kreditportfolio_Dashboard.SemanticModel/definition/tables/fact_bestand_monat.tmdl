	partition fact_bestand_monat = m
		mode: import
		source =
				let
				    Quelle = Csv.Document(File.Contents(Datenordner & "fact_bestand_monat.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Kopfzeilen = Table.PromoteHeaders(Quelle, [PromoteAllScalars = true]),
				    Typen = Table.TransformColumnTypes(Kopfzeilen, {{"datum", type date}, {"produkt", type text}, {"region", type text}, {"ratingklasse", Int64.Type}, {"verzugsstatus", type text}, {"anzahl_kredite", Int64.Type}, {"restschuld", type number}, {"restschuld_x_zins", type number}}, "en-US"),
				    Sortierung = Table.AddColumn(Typen, "verzugsstatus_sortierung", each Number.From(Text.Start([verzugsstatus], 1)), Int64.Type),
				    Bezeichnung = Table.TransformColumns(Sortierung, {{"verzugsstatus", each Text.AfterDelimiter(_, " "), type text}})
				in
				    Bezeichnung

	annotation PBI_ResultType = Table

