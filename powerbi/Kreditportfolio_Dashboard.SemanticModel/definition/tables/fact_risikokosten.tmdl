	partition fact_risikokosten = m
		mode: import
		source =
				let
				    Quelle = Csv.Document(File.Contents(Datenordner & "fact_risikokosten.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Kopfzeilen = Table.PromoteHeaders(Quelle, [PromoteAllScalars = true]),
				    Typen = Table.TransformColumnTypes(Kopfzeilen, {{"produkt", type text}, {"ratingklasse", Int64.Type}, {"pd_12m", type number}, {"pd_12m_ohne_stress", type number}, {"lgd", type number}, {"refinanzierung", type number}, {"risikokosten", type number}, {"risikokosten_ohne_stress", type number}}, "en-US")
				in
