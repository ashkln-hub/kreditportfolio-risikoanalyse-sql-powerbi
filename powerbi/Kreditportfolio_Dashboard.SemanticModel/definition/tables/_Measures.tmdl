table _Measures
	lineageTag: 547e7bf7-1448-54ec-8b6c-d3f3d245d016

	measure 'Letzter Stichtag' = CALCULATE ( MAX ( fact_bestand_monat[datum] ) )
		formatString: dd.MM.yyyy
		displayFolder: Basis
		lineageTag: 6f2cc71a-90fa-5041-b555-0764575d3002

	measure Bestand = SUM ( fact_bestand_monat[restschuld] )
		formatString: #,0 €
		displayFolder: Bestand
		lineageTag: 5cfcd7d6-03ea-53c5-ad80-13c3b6b21bfe

	measure 'Bestand Stichtag' =
			VAR _stichtag = [Letzter Stichtag]
			RETURN
			    CALCULATE ( [Bestand], dim_datum[datum] = _stichtag )
		formatString: #,0 €
		displayFolder: Bestand
		lineageTag: 247cd858-8501-5b6c-8f47-00f157a2c7cd

	measure 'Anzahl Kredite Stichtag' =
			VAR _stichtag = [Letzter Stichtag]
			RETURN
			    CALCULATE ( SUM ( fact_bestand_monat[anzahl_kredite] ), dim_datum[datum] = _stichtag )
		formatString: #,0
		displayFolder: Bestand
		lineageTag: 5455a8fb-b718-5d20-b182-00fa5cd23d5f

	measure 'Zins volumengewichtet' = DIVIDE ( SUM ( fact_bestand_monat[restschuld_x_zins] ), SUM ( fact_bestand_monat[restschuld] ) ) / 100
		formatString: 0.00%
		displayFolder: Bestand
		lineageTag: de005cc2-6b66-586d-aac1-24a27e0b7f51

	measure 'Zins volumengewichtet Stichtag' =
			VAR _stichtag = [Letzter Stichtag]
			RETURN
			    CALCULATE ( [Zins volumengewichtet], dim_datum[datum] = _stichtag )
		formatString: 0.00%
		displayFolder: Bestand
		lineageTag: bfef5a24-cb32-502b-a018-4a611e3f3eca

	measure 'Anteil am Bestand' = DIVIDE ( [Bestand Stichtag], CALCULATE ( [Bestand Stichtag], ALL ( fact_bestand_monat[verzugsstatus], fact_bestand_monat[verzugsstatus_sortierung] ) ) )
		formatString: 0.00%
		displayFolder: Bestand
		lineageTag: 075f0aa0-eeb7-582b-80c4-0bf313a4edf2

	measure 'NPL Volumen' = CALCULATE ( [Bestand], fact_bestand_monat[verzugsstatus_sortierung] = 4 )
		formatString: #,0 €
		displayFolder: Risiko
		lineageTag: 3c591585-0b7b-5457-9269-b36e0b37d82a

	measure NPL-Quote = DIVIDE ( [NPL Volumen], [Bestand] )
		formatString: 0.00%
		displayFolder: Risiko
		lineageTag: 5d0b94a7-872a-5774-8717-de2102d40b0f

	measure 'Verzugsquote 30+' = DIVIDE ( CALCULATE ( [Bestand], fact_bestand_monat[verzugsstatus_sortierung] > 1 ), [Bestand] )
		formatString: 0.00%
		displayFolder: Risiko
		lineageTag: 1613bafe-f81d-57b8-a909-f9c6a92a2e04

	measure 'NPL-Quote Stichtag' =
			VAR _stichtag = [Letzter Stichtag]
			RETURN
			    CALCULATE ( [NPL-Quote], dim_datum[datum] = _stichtag )
		formatString: 0.00%
		displayFolder: Risiko
		lineageTag: e572b1a8-a4ee-526b-8391-1885ca12801b

	measure 'NPL-Quote Vorjahr' =
			VAR _stichtag = [Letzter Stichtag]
			VAR _monat = YEAR ( _stichtag ) * 100 + MONTH ( _stichtag )
			RETURN
			    CALCULATE ( [NPL-Quote], FILTER ( ALL ( dim_datum ), dim_datum[monat_sort] = _monat - 100 ) )
		formatString: 0.00%
		displayFolder: Risiko
		lineageTag: f5335228-ef71-5c6c-8272-3c0cbbf462ce

	measure 'NPL-Quote Veränderung VJ (pp)' = ( [NPL-Quote Stichtag] - [NPL-Quote Vorjahr] ) * 100
		formatString: +0.00;-0.00;0.00
		displayFolder: Risiko
		lineageTag: 5398222d-0ab0-5364-b6fa-26bc32de8bcf

	measure 'NPL Volumen Stichtag' =
			VAR _stichtag = [Letzter Stichtag]
			RETURN
			    CALCULATE ( [NPL Volumen], dim_datum[datum] = _stichtag )
		formatString: #,0 €
		displayFolder: Risiko
		lineageTag: ce19b150-af61-5fb9-a45b-2266cb6403bc

	measure 'Neugeschäft Volumen' = SUM ( fact_neugeschaeft[volumen] )
		formatString: #,0 €
		displayFolder: Neugeschäft
		lineageTag: e53a3e20-af03-50b0-8612-504d8caddaa5

	measure 'Neugeschäft Anzahl' = SUM ( fact_neugeschaeft[anzahl_kredite] )
		formatString: #,0
		displayFolder: Neugeschäft
		lineageTag: 72b22772-5cc6-5c85-94c6-e4cffa8353ca

	measure 'Neugeschäft Zins' = DIVIDE ( SUM ( fact_neugeschaeft[volumen_x_zins] ), [Neugeschäft Volumen] ) / 100
		formatString: 0.00%
		displayFolder: Neugeschäft
		lineageTag: b8503780-bed4-5537-97d6-529e4717d675

	/// EAD der lebenden Kredite (Stufe 1 + 2)
	measure EAD = CALCULATE ( SUM ( fact_expected_loss[ead] ), fact_expected_loss[stufe] < 3 )
		formatString: #,0 €
		displayFolder: Expected Loss
		lineageTag: 18064db8-cf0c-5e39-9e01-d3cb4c416a70

	/// 12-Monats-EL der lebenden Kredite (Stufe 1 + 2), ökonomische LGD
	measure 'Expected Loss' = CALCULATE ( SUM ( fact_expected_loss[expected_loss] ), fact_expected_loss[stufe] < 3 )
		formatString: #,0 €
		displayFolder: Expected Loss
		lineageTag: 307885f5-ed2d-511e-b2a4-f24856727e80

	measure EL-Quote = DIVIDE ( [Expected Loss], [EAD] )
		formatString: 0.000%
		displayFolder: Expected Loss
		lineageTag: 23d1b8cf-3379-51b2-aa49-d824568caccb

	measure 'PD gewichtet' = DIVIDE ( SUMX ( FILTER ( fact_expected_loss, fact_expected_loss[stufe] < 3 ), fact_expected_loss[ead] * fact_expected_loss[pd_12m] ), [EAD] )
		formatString: 0.00%
		displayFolder: Expected Loss
		lineageTag: 8de12562-b1a5-586b-b674-565edc43d7c9

	measure 'LGD gewichtet' = DIVIDE ( [Expected Loss], SUMX ( FILTER ( fact_expected_loss, fact_expected_loss[stufe] < 3 ), fact_expected_loss[ead] * fact_expected_loss[pd_12m] ) )
		formatString: 0.0%
		displayFolder: Expected Loss
		lineageTag: 11d85035-7524-5858-b42a-2e9c7f5e8678

	/// PD × ökonomische LGD je Ratingklasse (fact_risikokosten, identisch mit sql/08), über Ratingklassen mit dem Neugeschäftsvolumen gewichtet
	measure Risikokosten =
			VAR _volumen = [Neugeschäft Volumen]
			RETURN
			    DIVIDE (
			        SUMX ( VALUES ( dim_rating[ratingklasse] ), [Neugeschäft Volumen] * CALCULATE ( MAX ( fact_risikokosten[risikokosten] ) ) ),
			        _volumen
			    )
		formatString: 0.00%
		displayFolder: Pricing
		lineageTag: 480b49a2-8618-573b-bbd9-4123e436148f

	/// Zins − Refinanzierung − Risikokosten. Betriebs- und Eigenkapitalkosten sind nicht enthalten.
	measure 'Marge nach Risikokosten' =
			// Sollzins Neugeschäft − Refinanzierung (Annahme, sql/00_annahme.sql) − Risikokosten (PD × LGD)
			// ohne Betriebs- und Eigenkapitalkosten
			IF ( ISBLANK ( [Risikokosten] ), BLANK (), [Neugeschäft Zins] - [Refinanzierung] - [Risikokosten] )
		formatString: 0.00%
		displayFolder: Pricing
		lineageTag: 52e89067-b6a2-5d09-8765-f00763048e08

	measure 'Ausfallrate kumuliert' =
			DIVIDE (
			    CALCULATE ( SUM ( fact_vintage[ausfaelle_kumuliert] ), fact_vintage[repraesentativ] = 1 ),
			    CALCULATE ( SUM ( fact_vintage[kredite_beobachtbar] ), fact_vintage[repraesentativ] = 1 )
			)
		formatString: 0.00%
		displayFolder: Vintage
		lineageTag: ef2def92-4a28-57e8-b9a0-1897fa90100a

	/// Beobachtete Rating-PD ohne Floor und ohne Verzugs-PD (zum Vergleich)
	measure 'PD gewichtet (roh)' = DIVIDE ( SUMX ( FILTER ( fact_expected_loss, fact_expected_loss[stufe] < 3 ), fact_expected_loss[ead] * fact_expected_loss[pd_rating_roh] ), [EAD] )
		formatString: 0.00%
		displayFolder: Expected Loss
		lineageTag: f648424a-0237-4c00-8cee-edbea3a23eb3

	/// 12-Monats-EL der lebenden Kredite mit nominaler statt ökonomischer LGD (zum Vergleich)
	measure 'EL nominale LGD' = SUMX ( FILTER ( fact_expected_loss, fact_expected_loss[stufe] < 3 ), fact_expected_loss[ead] * fact_expected_loss[pd_12m] * fact_expected_loss[lgd_nominal] )
		formatString: #,0 €
		displayFolder: Expected Loss
		lineageTag: 5f19045b-8e66-4f72-aae7-303e6d695aa4

	measure 'LGD nominal gewichtet' = DIVIDE ( [EL nominale LGD], SUMX ( FILTER ( fact_expected_loss, fact_expected_loss[stufe] < 3 ), fact_expected_loss[ead] * fact_expected_loss[pd_12m] ) )
		formatString: 0.0%
		displayFolder: Expected Loss
		lineageTag: db0b09b7-4724-4650-a848-c94ae734f895

	/// Mehr-EL, weil Kredite im Rückstand die Verzugs-PD statt der Rating-PD erhalten
	measure 'Effekt Verzugs-PD' = SUMX ( FILTER ( fact_expected_loss, fact_expected_loss[stufe] = 2 ), fact_expected_loss[ead] * ( fact_expected_loss[pd_12m] - fact_expected_loss[pd_rating] ) * fact_expected_loss[lgd] )
		formatString: #,0 €
		displayFolder: Expected Loss
		lineageTag: f1d27aae-3dbe-4dfa-8ef8-38c06e9e2d18

	/// Restschuld der ausgefallenen Kredite (Stufe 3) zum Stichtag
	measure 'EAD Ausfall' = CALCULATE ( SUM ( fact_expected_loss[ead] ), fact_expected_loss[stufe] = 3 )
		formatString: #,0 €
		displayFolder: Expected Loss
		lineageTag: 02f548a0-a3c7-41e0-9e36-b42c1baa8baa

	/// Verlustschätzung für ausgefallene Kredite = Restschuld × ökonomische LGD
	measure 'Verlust Ausfall' = CALCULATE ( SUM ( fact_expected_loss[expected_loss] ), fact_expected_loss[stufe] = 3 )
		formatString: #,0 €
		displayFolder: Expected Loss
		lineageTag: 9f2f6e6f-7af7-4c9a-bba2-a920b66b9850

	measure 'Verlust gesamt' = [Expected Loss] + [Verlust Ausfall]
		formatString: #,0 €
		displayFolder: Expected Loss
		lineageTag: 2940e68a-db92-43fd-a5a8-2508de6ffe0d

	/// Entspricht dem Bestand zum Stichtag
	measure 'EAD gesamt' = [EAD] + [EAD Ausfall]
		formatString: #,0 €
		displayFolder: Expected Loss
		lineageTag: 0245a997-763f-4ebe-a6f6-aa021f7ea8ce

	/// Annahme aus sql/00_annahme.sql
	measure Refinanzierung = MAX ( fact_risikokosten[refinanzierung] )
		formatString: 0.00%
		displayFolder: Pricing
		lineageTag: 91391738-4250-4a19-a9f0-79458259f2d4

	/// Wie Risikokosten, Pricing-PD ohne Kredite mit Auszahlung im Stressfenster 07/2022–12/2023
	measure 'Risikokosten ohne Stressfenster' =
			VAR _volumen = [Neugeschäft Volumen]
			RETURN
			    DIVIDE (
			        SUMX ( VALUES ( dim_rating[ratingklasse] ), [Neugeschäft Volumen] * CALCULATE ( MAX ( fact_risikokosten[risikokosten_ohne_stress] ) ) ),
			        _volumen
			    )
		formatString: 0.00%
		displayFolder: Pricing
		lineageTag: a4e81223-61f7-4938-a15a-9deaa1d59061

	/// Variante der Marge nach Risikokosten mit Pricing-PD ohne Stressfenster
	measure 'Marge nach Risikokosten ohne Stressfenster' = IF ( ISBLANK ( [Risikokosten ohne Stressfenster] ), BLANK (), [Neugeschäft Zins] - [Refinanzierung] - [Risikokosten ohne Stressfenster] )
		formatString: 0.00%
		displayFolder: Pricing
		lineageTag: ab5e63bf-073f-4fa1-91cc-db8d00da5382

	column Spalte1
		dataType: string
		isHidden
		lineageTag: 0081d7a6-a84f-52c7-922b-0a34380076a4
		summarizeBy: none
		sourceColumn: Spalte1

		annotation SummarizationSetBy = Automatic

	partition _Measures = m
		mode: import
		source =
				let
				    Quelle = #table(type table [Spalte1 = text], {})
				in
				    Quelle

	annotation PBI_ResultType = Table

