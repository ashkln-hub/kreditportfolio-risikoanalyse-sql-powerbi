	partition dim_datum = m
		mode: import
		source =
				let
				    Quelle = Csv.Document(File.Contents(Datenordner & "dim_datum.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Kopfzeilen = Table.PromoteHeaders(Quelle, [PromoteAllScalars = true]),
				    Typen = Table.TransformColumnTypes(Kopfzeilen, {{"datum", type date}, {"jahr", Int64.Type}, {"quartal", type text}, {"monat_nr", Int64.Type}, {"monat_jahr", type text}, {"monat_sort", Int64.Type}}, "en-US")
				in
				    Typen

	annotation PBI_ResultType = Table

