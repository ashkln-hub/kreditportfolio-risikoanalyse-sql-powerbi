// =====================================================================
// DAX-Measures des Power-BI-Dashboards "Kreditportfolio-Risikoanalyse"
// Identisch mit der Tabelle _Measures im Modell (powerbi/Kreditportfolio_Dashboard.SemanticModel).
// Hinweis: Dezimalzahlen als Bruch schreiben (z. B. 3 / 100), da das Modell die Kultur de-DE nutzt.
// Annahmen (Refinanzierung, PD-Floor, Diskontsatz) stehen in sql/00_annahme.sql und kommen
// über die Tabellen fact_expected_loss und fact_risikokosten ins Modell.
// Anzahl Measures: 36
// =====================================================================


// ---------- Basis --------------------------------------------------

Letzter Stichtag =
    CALCULATE ( MAX ( fact_bestand_monat[datum] ) )
// Format: dd.MM.yyyy


// ---------- Bestand ------------------------------------------------

Bestand =
    SUM ( fact_bestand_monat[restschuld] )
// Format: #,0 €

Bestand Stichtag =
    VAR _stichtag = [Letzter Stichtag]
    RETURN
        CALCULATE ( [Bestand], dim_datum[datum] = _stichtag )
// Format: #,0 €

Anzahl Kredite Stichtag =
    VAR _stichtag = [Letzter Stichtag]
    RETURN
        CALCULATE ( SUM ( fact_bestand_monat[anzahl_kredite] ), dim_datum[datum] = _stichtag )
// Format: #,0

Zins volumengewichtet =
    DIVIDE ( SUM ( fact_bestand_monat[restschuld_x_zins] ), SUM ( fact_bestand_monat[restschuld] ) ) / 100
// Format: 0.00%

Zins volumengewichtet Stichtag =
    VAR _stichtag = [Letzter Stichtag]
    RETURN
        CALCULATE ( [Zins volumengewichtet], dim_datum[datum] = _stichtag )
// Format: 0.00%

Anteil am Bestand =
    DIVIDE ( [Bestand Stichtag], CALCULATE ( [Bestand Stichtag], ALL ( fact_bestand_monat[verzugsstatus], fact_bestand_monat[verzugsstatus_sortierung] ) ) )
// Format: 0.00%


// ---------- Risiko -------------------------------------------------

NPL Volumen =
    CALCULATE ( [Bestand], fact_bestand_monat[verzugsstatus_sortierung] = 4 )
// Format: #,0 €

NPL-Quote =
    DIVIDE ( [NPL Volumen], [Bestand] )
// Format: 0.00%

Verzugsquote 30+ =
    DIVIDE ( CALCULATE ( [Bestand], fact_bestand_monat[verzugsstatus_sortierung] > 1 ), [Bestand] )
// Format: 0.00%

NPL-Quote Stichtag =
    VAR _stichtag = [Letzter Stichtag]
    RETURN
        CALCULATE ( [NPL-Quote], dim_datum[datum] = _stichtag )
// Format: 0.00%

NPL-Quote Vorjahr =
    VAR _stichtag = [Letzter Stichtag]
    VAR _monat = YEAR ( _stichtag ) * 100 + MONTH ( _stichtag )
    RETURN
        CALCULATE ( [NPL-Quote], FILTER ( ALL ( dim_datum ), dim_datum[monat_sort] = _monat - 100 ) )
// Format: 0.00%

NPL-Quote Veränderung VJ (pp) =
    ( [NPL-Quote Stichtag] - [NPL-Quote Vorjahr] ) * 100
// Format: +0.00;-0.00;0.00

NPL Volumen Stichtag =
    VAR _stichtag = [Letzter Stichtag]
    RETURN
        CALCULATE ( [NPL Volumen], dim_datum[datum] = _stichtag )
// Format: #,0 €


// ---------- Neugeschäft --------------------------------------------

Neugeschäft Volumen =
    SUM ( fact_neugeschaeft[volumen] )
// Format: #,0 €

Neugeschäft Anzahl =
    SUM ( fact_neugeschaeft[anzahl_kredite] )
// Format: #,0

Neugeschäft Zins =
    DIVIDE ( SUM ( fact_neugeschaeft[volumen_x_zins] ), [Neugeschäft Volumen] ) / 100
// Format: 0.00%


// ---------- Expected Loss ------------------------------------------

// EAD der lebenden Kredite (Stufe 1 + 2)
EAD =
    CALCULATE ( SUM ( fact_expected_loss[ead] ), fact_expected_loss[stufe] < 3 )
// Format: #,0 €

// 12-Monats-EL der lebenden Kredite (Stufe 1 + 2), ökonomische LGD
Expected Loss =
    CALCULATE ( SUM ( fact_expected_loss[expected_loss] ), fact_expected_loss[stufe] < 3 )
// Format: #,0 €

EL-Quote =
    DIVIDE ( [Expected Loss], [EAD] )
// Format: 0.000%

PD gewichtet =
    DIVIDE ( SUMX ( FILTER ( fact_expected_loss, fact_expected_loss[stufe] < 3 ), fact_expected_loss[ead] * fact_expected_loss[pd_12m] ), [EAD] )
// Format: 0.00%

LGD gewichtet =
    DIVIDE ( [Expected Loss], SUMX ( FILTER ( fact_expected_loss, fact_expected_loss[stufe] < 3 ), fact_expected_loss[ead] * fact_expected_loss[pd_12m] ) )
// Format: 0.0%

// Beobachtete Rating-PD ohne Floor und ohne Verzugs-PD (zum Vergleich)
PD gewichtet (roh) =
    DIVIDE ( SUMX ( FILTER ( fact_expected_loss, fact_expected_loss[stufe] < 3 ), fact_expected_loss[ead] * fact_expected_loss[pd_rating_roh] ), [EAD] )
// Format: 0.00%

// 12-Monats-EL der lebenden Kredite mit nominaler statt ökonomischer LGD (zum Vergleich)
EL nominale LGD =
    SUMX ( FILTER ( fact_expected_loss, fact_expected_loss[stufe] < 3 ), fact_expected_loss[ead] * fact_expected_loss[pd_12m] * fact_expected_loss[lgd_nominal] )
// Format: #,0 €

LGD nominal gewichtet =
    DIVIDE ( [EL nominale LGD], SUMX ( FILTER ( fact_expected_loss, fact_expected_loss[stufe] < 3 ), fact_expected_loss[ead] * fact_expected_loss[pd_12m] ) )
// Format: 0.0%

// Mehr-EL, weil Kredite im Rückstand die Verzugs-PD statt der Rating-PD erhalten
Effekt Verzugs-PD =
    SUMX ( FILTER ( fact_expected_loss, fact_expected_loss[stufe] = 2 ), fact_expected_loss[ead] * ( fact_expected_loss[pd_12m] - fact_expected_loss[pd_rating] ) * fact_expected_loss[lgd] )
// Format: #,0 €

// Restschuld der ausgefallenen Kredite (Stufe 3) zum Stichtag
EAD Ausfall =
    CALCULATE ( SUM ( fact_expected_loss[ead] ), fact_expected_loss[stufe] = 3 )
// Format: #,0 €

// Verlustschätzung für ausgefallene Kredite = Restschuld × ökonomische LGD
Verlust Ausfall =
    CALCULATE ( SUM ( fact_expected_loss[expected_loss] ), fact_expected_loss[stufe] = 3 )
// Format: #,0 €

Verlust gesamt =
    [Expected Loss] + [Verlust Ausfall]
// Format: #,0 €

// Entspricht dem Bestand zum Stichtag
EAD gesamt =
    [EAD] + [EAD Ausfall]
// Format: #,0 €


// ---------- Pricing ------------------------------------------------

// PD × ökonomische LGD je Ratingklasse (fact_risikokosten, identisch mit sql/08), über Ratingklassen mit dem Neugeschäftsvolumen gewichtet
Risikokosten =
    VAR _volumen = [Neugeschäft Volumen]
    RETURN
        DIVIDE (
            SUMX ( VALUES ( dim_rating[ratingklasse] ), [Neugeschäft Volumen] * CALCULATE ( MAX ( fact_risikokosten[risikokosten] ) ) ),
            _volumen
        )
// Format: 0.00%

// Zins − Refinanzierung − Risikokosten. Betriebs- und Eigenkapitalkosten sind nicht enthalten.
Marge nach Risikokosten =
    // Sollzins Neugeschäft − Refinanzierung (Annahme, sql/00_annahme.sql) − Risikokosten (PD × LGD)
    // ohne Betriebs- und Eigenkapitalkosten
    IF ( ISBLANK ( [Risikokosten] ), BLANK (), [Neugeschäft Zins] - [Refinanzierung] - [Risikokosten] )
// Format: 0.00%

// Annahme aus sql/00_annahme.sql
Refinanzierung =
    MAX ( fact_risikokosten[refinanzierung] )
// Format: 0.00%

// Wie Risikokosten, Pricing-PD ohne Kredite mit Auszahlung im Stressfenster 07/2022–12/2023
Risikokosten ohne Stressfenster =
    VAR _volumen = [Neugeschäft Volumen]
    RETURN
        DIVIDE (
            SUMX ( VALUES ( dim_rating[ratingklasse] ), [Neugeschäft Volumen] * CALCULATE ( MAX ( fact_risikokosten[risikokosten_ohne_stress] ) ) ),
            _volumen
        )
// Format: 0.00%

// Variante der Marge nach Risikokosten mit Pricing-PD ohne Stressfenster
Marge nach Risikokosten ohne Stressfenster =
    IF ( ISBLANK ( [Risikokosten ohne Stressfenster] ), BLANK (), [Neugeschäft Zins] - [Refinanzierung] - [Risikokosten ohne Stressfenster] )
// Format: 0.00%


// ---------- Vintage ------------------------------------------------

Ausfallrate kumuliert =
    DIVIDE (
        CALCULATE ( SUM ( fact_vintage[ausfaelle_kumuliert] ), fact_vintage[repraesentativ] = 1 ),
        CALCULATE ( SUM ( fact_vintage[kredite_beobachtbar] ), fact_vintage[repraesentativ] = 1 )
    )
// Format: 0.00%
