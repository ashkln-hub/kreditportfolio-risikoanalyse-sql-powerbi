// =====================================================================
// DAX-Measures für das Power-BI-Dashboard "Kreditportfolio-Risikoanalyse"
// Anlegen in einer eigenen Tabelle "_Measures" (Start → Daten eingeben → leere Tabelle).
// Format in Klammern = in Power BI unter "Measuretools → Format" einstellen.
// =====================================================================


// ---------- Stichtag -------------------------------------------------

Letzter Stichtag =
    CALCULATE ( MAX ( fact_bestand_monat[datum] ) )
// Format: Datum


// ---------- Bestand --------------------------------------------------

Bestand =
    SUM ( fact_bestand_monat[restschuld] )
// Format: Währung €, 0 Dezimalstellen

Bestand Stichtag =
    VAR _stichtag = [Letzter Stichtag]
    RETURN
        CALCULATE ( [Bestand], dim_datum[datum] = _stichtag )
// Bestand zum letzten Monat des gewählten Zeitraums (für Karten)

Anzahl Kredite Stichtag =
    VAR _stichtag = [Letzter Stichtag]
    RETURN
        CALCULATE ( SUM ( fact_bestand_monat[anzahl_kredite] ), dim_datum[datum] = _stichtag )
// Format: Ganze Zahl

Zins volumengewichtet =
    DIVIDE (
        SUM ( fact_bestand_monat[restschuld_x_zins] ),
        SUM ( fact_bestand_monat[restschuld] )
    ) / 100
// Format: Prozent, 2 Dezimalstellen


// ---------- Verzug und NPL -------------------------------------------

NPL Volumen =
    CALCULATE ( [Bestand], fact_bestand_monat[verzugsstatus] = "4 Ausfall 90+ Tage" )

NPL-Quote =
    DIVIDE ( [NPL Volumen], [Bestand] )
// Format: Prozent, 2 Dezimalstellen

Verzugsquote 30+ =
    DIVIDE (
        CALCULATE ( [Bestand], fact_bestand_monat[verzugsstatus] <> "1 vertragsgemäß" ),
        [Bestand]
    )
// Format: Prozent, 2 Dezimalstellen

NPL-Quote Stichtag =
    VAR _stichtag = [Letzter Stichtag]
    RETURN
        CALCULATE ( [NPL-Quote], dim_datum[datum] = _stichtag )

NPL-Quote Vorjahr =
    VAR _stichtag = [Letzter Stichtag]
    VAR _monat = YEAR ( _stichtag ) * 100 + MONTH ( _stichtag )
    RETURN
        CALCULATE ( [NPL-Quote], FILTER ( ALL ( dim_datum ), dim_datum[monat_sort] = _monat - 100 ) )

NPL-Quote Veränderung VJ (pp) =
    ( [NPL-Quote Stichtag] - [NPL-Quote Vorjahr] ) * 100
// Format: Dezimalzahl, 2 Dezimalstellen → Anzeige in Prozentpunkten


// ---------- Neugeschäft ----------------------------------------------

Neugeschäft Volumen =
    SUM ( fact_neugeschaeft[volumen] )
// Format: Währung €, 0 Dezimalstellen

Neugeschäft Anzahl =
    SUM ( fact_neugeschaeft[anzahl_kredite] )

Neugeschäft Zins =
    DIVIDE ( SUM ( fact_neugeschaeft[volumen_x_zins] ), [Neugeschäft Volumen] ) / 100
// Format: Prozent, 2 Dezimalstellen


// ---------- Expected Loss (Stichtag 30.09.2026) -----------------------

EAD =
    SUM ( fact_expected_loss[ead] )
// Format: Währung €, 0 Dezimalstellen

Expected Loss =
    SUM ( fact_expected_loss[expected_loss] )
// Format: Währung €, 0 Dezimalstellen

EL-Quote =
    DIVIDE ( [Expected Loss], [EAD] )
// Format: Prozent, 3 Dezimalstellen

PD gewichtet =
    DIVIDE ( SUMX ( fact_expected_loss, fact_expected_loss[ead] * fact_expected_loss[pd_12m] ), [EAD] )
// Format: Prozent, 2 Dezimalstellen

LGD gewichtet =
    DIVIDE (
        [Expected Loss],
        SUMX ( fact_expected_loss, fact_expected_loss[ead] * fact_expected_loss[pd_12m] )
    )
// Format: Prozent, 1 Dezimalstelle


// ---------- Vintage --------------------------------------------------

Ausfallrate kumuliert =
    DIVIDE (
        CALCULATE ( SUM ( fact_vintage[ausfaelle_kumuliert] ), fact_vintage[repraesentativ] = 1 ),
        CALCULATE ( SUM ( fact_vintage[kredite_beobachtbar] ), fact_vintage[repraesentativ] = 1 )
    )
// Format: Prozent, 2 Dezimalstellen
